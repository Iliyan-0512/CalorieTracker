<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalorieTracker.Maui.ViewModels"
             xmlns:models="clr-namespace:CalorieTracker.Core.Models;assembly=CalorieTracker.Core"
             x:Class="CalorieTracker.Maui.Views.AddFoodPage"
             x:DataType="vm:AddFoodViewModel"
             Style="{StaticResource PageBackground}"
             Title="Добави храна">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,8" RowSpacing="10">

        <!-- Търсене -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <SearchBar Placeholder="Търси храна…" Text="{Binding SearchText}" />
            <Picker Grid.Column="1" ItemsSource="{Binding MealTypes}" SelectedIndex="{Binding MealIndex}"
                    WidthRequest="120" Title="Хранене" />
        </Grid>

        <!-- Баркод -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Entry Placeholder="Баркод (EAN)" Keyboard="Numeric" Text="{Binding Barcode}"
                   ReturnCommand="{Binding LookupBarcodeCommand}" />
            <Button Grid.Column="1" Text="Търси" Command="{Binding LookupBarcodeCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="2" Text="Нова" Command="{Binding NewFoodCommand}" Style="{StaticResource SecondaryButton}" />
        </Grid>

        <!-- Резултати -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Results}" SelectionMode="None">
            <CollectionView.Header>
                <Label Text="{Binding ListHeader}" Style="{StaticResource Caption}" Margin="4,4,0,6" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Food">
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectCommand, Source={RelativeSource AncestorType={x:Type vm:AddFoodViewModel}}, x:DataType=vm:AddFoodViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontSize="15" />
                                <Label Style="{StaticResource Caption}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Protein, StringFormat='Б {0:0.#} · '}" />
                                            <Span Text="{Binding Carbs, StringFormat='В {0:0.#} · '}" />
                                            <Span Text="{Binding Fat, StringFormat='М {0:0.#} (на 100 g)'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Calories, StringFormat='{0:0} kcal'}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Избрана храна -->
        <Border Grid.Row="3" Style="{StaticResource Card}" IsVisible="{Binding IsFoodSelected}" Margin="0,0,0,8">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding SelectedFood.Name, x:DataType=vm:AddFoodViewModel}" Style="{StaticResource SectionTitle}" />
                    <Button Grid.Column="1" Text="✕" Padding="0" WidthRequest="36" HeightRequest="36"
                            Style="{StaticResource SecondaryButton}" Command="{Binding ClearSelectionCommand}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="Количество (g):" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Keyboard="Numeric" Text="{Binding GramsText}" />
                </Grid>
                <Label Text="{Binding PreviewText}" Style="{StaticResource Caption}" />
                <Button Text="Добави в дневника" Command="{Binding AddCommand}" />
            </VerticalStackLayout>
        </Border>

        <ActivityIndicator Grid.RowSpan="4" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
